    {
      "name": "clm_list_contracts",
      "introducedInCapabilityPolicyVersion": 1,
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "List contracts"
      },
      "effect": {
        "boundary": "workspace",
        "kind": "read",
        "retry": "read"
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "categoryId": {
            "description": "Return only contracts with this contract type.",
            "format": "uuid",
            "type": "string"
          },
          "counterpartyId": {
            "description": "Return only contracts assigned to this party as party_b.",
            "format": "uuid",
            "type": "string"
          },
          "cursor": {
            "description": "Continuation reference from the previous page. Reuse it with the same filters.",
            "type": "string"
          },
          "endDateFrom": {
            "description": "Return contracts with a non-null end date on or after this inclusive YYYY-MM-DD date.",
            "format": "date",
            "type": "string"
          },
          "endDateTo": {
            "description": "Return contracts with a non-null end date on or before this inclusive YYYY-MM-DD date.",
            "format": "date",
            "type": "string"
          },
          "folderId": {
            "description": "Only return contracts filed in this visible folder.",
            "format": "uuid",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "Page size (max 100).",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "noticeDateFrom": {
            "description": "Return contracts with a computed non-null notice date on or after this inclusive YYYY-MM-DD date.",
            "format": "date",
            "type": "string"
          },
          "noticeDateTo": {
            "description": "Return contracts with a computed non-null notice date on or before this inclusive YYYY-MM-DD date.",
            "format": "date",
            "type": "string"
          },
          "query": {
            "description": "Literal case-insensitive substring in the contract title or assigned party_b display or legal name.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "description": "Return only this contract status.",
            "enum": [
              "active",
              "notice-given",
              "terminated",
              "expired"
            ],
            "type": "string"
          },
          "updatedSince": {
            "description": "Return contracts updated at or after this ISO-8601 timestamp.",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
