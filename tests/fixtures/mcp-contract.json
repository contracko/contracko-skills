        "retry": "none"
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "fileName": {
            "description": "Original file name including extension",
            "minLength": 1,
            "type": "string"
          },
          "fileSize": {
            "description": "File size in bytes",
            "exclusiveMinimum": 0,
            "maximum": 52428800,
            "type": "integer"
          },
          "mimeType": {
            "description": "File type of the uploaded document",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[\\w.+-]+\\/[\\w.+-]+$",
            "type": "string"
          },
          "sha256": {
            "description": "Optional lowercase hex SHA-256 of the file; the import rejects different bytes",
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "fileName",
          "mimeType",
          "fileSize"
        ],
        "type": "object"
